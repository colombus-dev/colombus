{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "off"
			}
		},
		"includes": [
			"**",
			"!dist",
			"!src/components/ui/*",
			"!src/hooks/editor/CanopusDSL*.js"
		]
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"tailwind": {
		"stylesheet": "src/index.css"
	},
	"html": {
		"formatter": {
			"indentScriptAndStyle": false,
			"selfCloseVoidElements": "always"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
